# MongoDB connection string (rotate any password that has ever been shared/exposed)
DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/yourtube?retryWrites=true&w=majority

# Production frontend origin (Vercel URL). Used for CORS.
FRONTEND_URL=http://localhost:3000

# Required for new video uploads. Create these in Cloudinary Console > Settings > API Keys.
# Keep CLOUDINARY_API_SECRET private; never use a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: a persistent directory for uploaded videos in production.
# Leave unset locally to use server/uploads.
# UPLOAD_DIR=/opt/render/project/src/server/uploads

# Do NOT set PORT here for Render — Render injects it automatically.
# PORT=5000

# Required for secure login. Paste the single-line Firebase service-account JSON
# in your host's secret manager; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
SESSION_DAYS=7
# Percentage watched before a video is marked completed (1-100).
WATCH_COMPLETION_PERCENT=90
