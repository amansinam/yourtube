# MongoDB connection string (rotate any password that has ever been shared/exposed)
DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/yourtube?retryWrites=true&w=majority

# Production frontend origin (Vercel URL). Used for CORS.
FRONTEND_URL=http://localhost:3000

# Optional: a persistent directory for uploaded videos in production.
# Leave unset locally to use server/uploads.
# UPLOAD_DIR=/opt/render/project/src/server/uploads

# Do NOT set PORT here for Render — Render injects it automatically.
# PORT=5000
